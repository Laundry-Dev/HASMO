	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: [
				"まず、このMODPACKの最終目標は「すべてのボスを倒すこと」です。シンプルですね。"
				"初期設定では、“P”キーを押すと討伐すべきボスの一覧が表示されます。"
				"ですが今はそのことは置いておきましょう。"
				"今夜を生き延びることだけに集中してください。"
			]
			id: "39A5EE868FC6F42E"
			subtitle: "敵が強すぎるような気もする"
			tasks: [{
				id: "0A6E670733AD3128"
				title: "この世界について"
				type: "checkmark"
			}]
			x: 0.0d
			y: 0.0d
		}
		{
			description: [
				"倒すにも場所が分からないですって？、これをプレゼントします"
				"使い方は右クリックして、構造物のIDを入力するだけです"
			]
			id: "3AB97679080E3167"
			rewards: [{
				id: "1B7EE10A927C9BBC"
				item: {
					Count: 1
					id: "explorerscompass:explorerscompass"
					tag: { }
				}
				type: "item"
			}]
			tasks: [{
				id: "0581F2600F388514"
				title: "ボスを探すため"
				type: "checkmark"
			}]
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["39A5EE868FC6F42E"]
			description: [
				"ボスを倒すとは言いましたが、今のままでは十中八九、勝てません。"
				"まずはしっかり準備を整えましょう。"
				""
				"この世界では、敵を倒すと**“聖遺物（アーティファクト）”と呼ばれるアイテムが、そこそこの確率でドロップします。"
				"聖遺物には★1から★5までの等級**があり、星が高いほど性能も強力になります。"
				""
				"つまり、敵をたくさん倒して、どんどん強くなれ！"
				"……それだけの話です。シンプルですね。"
			]
			id: "52C3060421A70FA3"
			subtitle: "まずは基礎から"
			tasks: [{
				id: "3A93FEF4CC9C7EC8"
				title: "基礎"
				type: "checkmark"
			}]
			x: 0.0d
			y: -3.0d
		}
		{
			dependencies: ["52C3060421A70FA3"]
			dependency_requirement: "all_started"
			description: [
				"ですが、この世界はそうそう上手くはいきません。敵は複数の条件によって強くなります。"
				"詳しく説明します。まず、この世界には「危険度」という概念があり、敵の強さはその危険度を参照して上がっていきます。"
				"危険度が上がる主な条件は次の通りです："
				"敵を倒す — 討伐数に応じて危険度が上昇します。"
				"遠出する — 拠点（リス地）から遠くなるほど、その地域の危険度が高くなります。"
				"ボスを撃破する — ボス討伐も危険度を引き上げる要因です。"
				"要するに、リス地から遠ざかるほど危険度が増すため、安易な遠出は推奨できません。とはいえ、遠出はいつか必ず必要になります。"
			]
			id: "5E612062B1B50DD0"
			subtitle: "敵が強い"
			tasks: [{
				id: "1C5D101020EECA1C"
				title: "そう上手くはいかない"
				type: "checkmark"
			}]
			x: 0.0d
			y: -6.0d
		}
		{
			dependencies: ["5E612062B1B50DD0"]
			description: [
				"そして、恐ろしいことに&n&l危険度を下げる手段は存在しません。"
				""
				"つまり、敵やボスを倒して自分が強くなっても、敵も一緒に強くなるということです。"
				"あなたが成長するほど、世界もそれに合わせて牙を研ぐ。"
				""
				"だからこそ、どのタイミングで強化するか、その“塩梅”がとても重要なのです。"
			]
			id: "63DEA6352257F385"
			subtitle: "この世界が如何に恐ろしいか"
			tasks: [{
				id: "34EA6C55C5F7DF00"
				title: "そして"
				type: "checkmark"
			}]
			x: 0.0d
			y: -9.0d
		}
		{
			dependencies: ["63DEA6352257F385"]
			description: [
				"この世界にも、優しい一面があります"
				"まず、ツールを使用しても耐久値が減らないという点です"
				"ただし注意してください。ツールや耐久値を持つアイテムは、死亡時に一定の割合で耐久が減少します"
				"そしてもう一つ。"
				"この世界には食料ゲージが存在しません。"
				"代わりに、食べ物を食べることで直接体力が回復します"
				"つまり、料理もまた、生き残るための重要な要素というわけです"
			]
			id: "4295D4B537167141"
			rewards: [{
				count: 16
				id: "67C00626FE0AB4C9"
				item: "kaleidoscope_cookery:frost_lamb_chop"
				type: "item"
			}]
			subtitle: "ちゃんとある"
			tasks: [{
				id: "56B38C46FE14AC72"
				title: "優しい要素も"
				type: "checkmark"
			}]
			x: 2.5d
			y: -9.0d
		}
	]
	title: "チュートリアル"
}
