{
	default_hide_dependency_lines: false
	default_quest_shape: ""
	filename: "l2_hostility"
	group: "12F3D2BD1F2D19AC"
	icon: "l2hostility:teleport"
	id: "7AA8DA7FF0FCDCFF"
	order_index: 3
	quest_links: [ ]
	quests: [
		{
			description: [
				"この世界では\"危険度\"が存在し、危険度はモブを倒すほど上がっていきます"
				"危険度を参照しモブの\"レベル\"が上がっていき、レベルが上がるごとにモブの攻撃力や体力が強化され、強力な能力が付与される可能性もあります"
			]
			id: "10887F38F89FC4A6"
			tasks: [{
				id: "37822B5C681A72C4"
				title: "L2 Hostility"
				type: "checkmark"
			}]
			x: -1.0d
			y: 0.5d
		}
		{
			dependencies: ["10887F38F89FC4A6"]
			description: ["初期スポーン地点から離れるほど危険度の高いモブが出現し、また別ディメンションに行くなどすると危険度が上昇します"]
			id: "1BFE42584F17C6F7"
			tasks: [{
				id: "00E7781FF2649653"
				type: "checkmark"
			}]
			x: 1.0d
			y: 0.5d
		}
		{
			dependencies: ["1BFE42584F17C6F7"]
			description: ["ボス級のモブは特にレベルが高くなり、後述する\"特性\"を多く保有します"]
			id: "6C446E0586FEF69B"
			tasks: [{
				id: "7ADEB179B195AD8F"
				title: "ボス"
				type: "checkmark"
			}]
			x: 3.0d
			y: 0.5d
		}
		{
			dependencies: ["6C446E0586FEF69B"]
			description: [
				"レベルが20を超えた辺りから、特定の能力を持つモブが出現し始めます、この能力は\"特性\"と呼ばれます"
				"特性はモブの名前の上に表示されるため、警戒は容易です"
			]
			id: "72C9692D1732911F"
			tasks: [{
				id: "72FA8D5126C896A9"
				title: "特性"
				type: "checkmark"
			}]
			x: 5.0d
			y: 0.5d
		}
		{
			dependencies: ["72C9692D1732911F"]
			description: [
				"100レベルを超えると、伝説特性をもつモブが出現し始めます、シュルカー攻撃、透明化、物理無効、防御無効、不死身などです"
				"不死身の敵は、エンチャント「Cursed Blade」が付いた武器で攻撃するか、Cursed効果のポーションを投げて付与している間に攻撃することで倒せます"
			]
			id: "72A35BF783F8F2F6"
			tasks: [{
				id: "0BD3385838EB2299"
				title: "特性２"
				type: "checkmark"
			}]
			x: 7.0d
			y: 0.5d
		}
		{
			dependencies: ["72A35BF783F8F2F6"]
			description: [
				"さぁ、反撃の始まりです"
				"まずはこのアイテムをクラフトしましょう"
				"このアイテムを持つと、現在の危険度とモブの特性レベルが分かります"
			]
			id: "4732A51782802BC1"
			tasks: [{
				id: "282239CA6202494C"
				item: "l2hostility:hostility_detector"
				type: "item"
			}]
			x: 8.5d
			y: -1.0d
		}
		{
			dependencies: ["4732A51782802BC1"]
			description: [
				"次に、このアイテムを手に入れましょう"
				"このアイテムは\"特性\"を持つ敵を倒すと一定確率でドロップします"
				"このアイテム単体だと意味が無いため、次のクエストに進みましょう"
			]
			id: "606825C7CB11E33B"
			tasks: [{
				id: "44FCFD52929F4F04"
				item: "l2hostility:hostility_orb"
				type: "item"
			}]
			x: 10.5d
			y: -1.0d
		}
		{
			dependencies: ["606825C7CB11E33B"]
			description: [
				"これをキュリオススロットの頭に装着すると、見えない敵も見えるようになります"
				"ですがそれだけではありません、先程のアイテムと組み合わせることでより強力になります"
			]
			id: "3E4ACA00AC14026E"
			tasks: [{
				id: "74904F03265CC24D"
				item: "l2hostility:detector_glasses"
				type: "item"
			}]
			x: 12.5d
			y: -1.0d
		}
		{
			dependencies: ["3E4ACA00AC14026E"]
			description: [
				"敵意のオーブをオフハンド、敵意探知機をメインハンドに持ち、メガネを装着した状態で地面を右クリックするとチャンクが表示されます"
				"クリックしたチャンクにはレベルや特性が付与されたモブはスポーンしません"
				"おめでとうございます！報酬を受け取ってください！"
			]
			id: "2B584394206CC652"
			rewards: [
				{
					count: 32
					id: "6A81B5CF5DE217BF"
					item: "l2complements:enchanted_totemic_apple"
					type: "item"
				}
				{
					id: "108525BC0EC8C0F7"
					item: "l2artifacts:random_set_5"
					type: "item"
				}
			]
			tasks: [{
				id: "681EDD89C9F17231"
				title: "安全地帯"
				type: "checkmark"
			}]
			x: 14.5d
			y: -1.0d
		}
		{
			dependencies: ["72A35BF783F8F2F6"]
			description: [
				"あなたが攻撃は最大の防御だと思っているなら、このルートは非常におすすめできます"
				"まずはこのアイテムを作成しましょう"
				"作成したら、キュリオススロットに装着し敵を倒しましょう"
				"このアイテムを装備した状態で敵を倒すと、様々なアイテムが追加でドロップするようになります"
			]
			id: "4C68AA0D72989A99"
			tasks: [{
				id: "5034DAD20DAA1B08"
				item: "l2hostility:charm_of_looting_1"
				type: "item"
			}]
			x: 8.5d
			y: 2.0d
		}
		{
			dependencies: ["4C68AA0D72989A99"]
			description: ["そして次はこのアイテムを作成しましょう、これを装備した状態で敵を倒すと、次のチャームを作成するために必要なアイテムが入手できます"]
			id: "5EB1C2DCCE08B2DA"
			rewards: [{
				count: 2
				id: "2DB5E44ED349C6AD"
				item: "l2hostility:bottle_of_curse"
				type: "item"
			}]
			tasks: [{
				id: "3222274C8F8FB528"
				item: "l2hostility:charm_of_looting_2"
				type: "item"
			}]
			x: 10.5d
			y: 2.0d
		}
		{
			dependencies: ["5EB1C2DCCE08B2DA"]
			description: ["まだまだ通過点に過ぎません、次に進みましょう！"]
			id: "33FA9D564CF9E024"
			tasks: [{
				id: "25CD0E4BC682BA4B"
				item: "l2hostility:chaos_ingot"
				type: "item"
			}]
			x: 12.5d
			y: 2.0d
		}
		{
			dependencies: ["33FA9D564CF9E024"]
			description: [
				"これを装備した状態で敵を倒すと、一部の特殊なアイテムを入手できます"
				"それらはこの先特殊な\"呪い\"をクラフトするのに必要です"
			]
			id: "48C9D873DC941BB2"
			rewards: [{
				count: 10
				id: "1563CA48E8652632"
				item: "l2hostility:witch_droplet"
				type: "item"
			}]
			tasks: [{
				id: "29E0FEF6E57DB3E4"
				item: "l2hostility:charm_of_looting_3"
				type: "item"
			}]
			x: 14.5d
			y: 2.0d
		}
		{
			dependencies: ["48C9D873DC941BB2"]
			description: [
				"さて、ここから所謂\"エンドコンテンツ\"と言われる部類に入ります"
				"この\"呪い\"を装備した状態で敵を倒すと、倒した敵の特性をドロップします(一定確率ですが)"
				"その特性を使い様々な\"呪い\"を作成しましょう！"
			]
			id: "1D3BFD012B0E746D"
			tasks: [{
				id: "2520D9F54E4C3248"
				item: "l2hostility:curse_of_envy"
